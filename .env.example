# Copy with `npm run setup`, which fills the two placeholders below with random values.
# Used by Docker Compose (via --env-file) to create the local database.
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# Must use the same password as above. Host port 5433 (5432 is often taken).
DATABASE_URL=postgres://azentio:__POSTGRES_PASSWORD__@localhost:5433/azentio_ai
SESSION_SECRET=__SESSION_SECRET__
# Minimum distinct contributing organisations for shared trend statistics (brief: >=3 for judging)
MIN_DISTINCT_ORGS=3
# Optional: AIRA uses a deterministic fallback when unset
ANTHROPIC_API_KEY=
# Optional: override the AIRA model (default claude-opus-5-5)
AIRA_MODEL=
